#!/usr/bin/env bash
set -e
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ -f "$ROOT/.amsim/local.env" ]]; then
  set -a
  source "$ROOT/.amsim/local.env"
  set +a
fi
export AMSIM_WORKSPACE="${AMSIM_WORKSPACE:-$(dirname "$ROOT")}"
export AMSIM_PX4_DIR="${AMSIM_PX4_DIR:-$AMSIM_WORKSPACE/PX4-Autopilot}"
export AMSIM_ROS_WS="${AMSIM_ROS_WS:-$AMSIM_WORKSPACE/ros2_px4_ws}"
export AMSIM_RESULTS_DIR="${AMSIM_RESULTS_DIR:-$ROOT/runs}"
export AMSIM_VENV="$ROOT/.amsim/comparison-venv"
export AMSIM_SCENARIO_PYTHON="$AMSIM_VENV/bin/python3"
export PYTHONNOUSERSITE=1
export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-0}" ROS_LOCALHOST_ONLY="${ROS_LOCALHOST_ONLY:-0}"
export RMW_IMPLEMENTATION="${RMW_IMPLEMENTATION:-rmw_fastrtps_cpp}"
export HEADLESS=1 PX4_SIM_SPEED_FACTOR=1
export GZ_PARTITION="${GZ_PARTITION:-amsim_x650_compare}"
source /opt/ros/humble/setup.bash
source "$AMSIM_ROS_WS/install/setup.bash"
export PYTHONPATH="$ROOT/src:$ROOT${PYTHONPATH:+:$PYTHONPATH}"
if [[ ! -x "$AMSIM_SCENARIO_PYTHON" ]]; then
  echo 'Run ./scripts/setup_x650_comparison.sh first.' >&2
  exit 1
fi
exec "$AMSIM_SCENARIO_PYTHON" "$ROOT/simulations/x650_control_comparison_v1/cli.py" "$@"
